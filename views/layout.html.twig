<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="title" content="Moko Food" />
    <meta name="description"
      content="Moko Food, restaurant coréen à Saint-Brieuc, vous fait découvrir les saveurs authentiques de la Corée : barbecue coréen, bibimbap, poulet frit coréen et spécialités asiatiques dans une ambiance chaleureuse et conviviale." />
    <meta name="keywords"
      content="restaurant coréen Saint-Brieuc, cuisine coréenne Saint-Brieuc, barbecue coréen, bibimbap, poulet frit coréen, restaurant asiatique Saint-Brieuc, spécialités coréennes, restaurant centre-ville Saint-Brieuc, tteokbokki, japchae, korean food Bretagne, restaurant coréen Bretagne, cuisine asiatique authentique, manger coréen Saint-Brieuc, Moko Food Saint-Brieuc" />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="language" content="French" />
    <meta name="revisit-after" content="5 days" />
    <meta name="author" content="Killian" />
    <title>
      {% block title %}
        Moko Food
      {% endblock %}
    </title>
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="{{ base_path }}public/css/style.css" />
  </head>

  <body>
    <header>
      <nav>
        <a href="index.php" class="logo">
          <img src="{{ base_path }}public/images/logomoko.svg"

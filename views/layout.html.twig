        </a>

        <button class="burger">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <ul class="nav-links">
          <li><a href="index.php">Accueil</a></li>
          <li><a href="index.php?route=histoire">Notre Histoire</a></li>
          <li><a href="index.php?route=carte">La carte</a></li>
          <li><a href="index.php?route=reservation">Réservation</a></li>
          <li><a href="index.php?route=avis">Avis</a></li>
          <li><a href="index.php?route=contact">Contact</a></li>
        </ul>
        <a href="index.php?route=reservation" class="btn-reserve">Réserver</a>
      </nav>
    </header>
    <main>
      {% block content %}

      {% endblock %}
    </main>
    <footer>
      <p class="footer-logo">
        모코 MOKO FOOD
